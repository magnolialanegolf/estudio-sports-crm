// Modelo de datos del CRM comercial de Estudio Sports.
// Montos en pesos mexicanos sin IVA, enteros. Porcentajes como fracción (0.25 = 25 %).
// Cada entidad financiera lleva la bandera `confirmado` para distinguir dato
// respaldado de dato estimado heredado del control anterior en Excel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN_GENERAL      // configura todo
  GERENTE_GENERAL    // ve todo, incluidas comisiones; no configura reglas ni usuarios
  DIRECTOR           // su cartera; ve sus comisiones
  ASISTENTE_COMERCIAL // captura en la cartera de un director; no ve comisiones
  ADMINISTRACION     // pagos y facturación de todas las carteras; sin comisiones
  PRODUCCION         // tareas asignadas
  CONTENIDOS         // tareas asignadas
  OPERATIVO          // tareas asignadas
  LECTURA
}

enum TipoContrato {
  COMERCIAL
  PODCAST
  EMBAJADURIA
  OTRO
}

enum EstadoContrato {
  PROSPECTO
  PROPUESTA
  PENDIENTE_FIRMA
  VIGENTE
  FINALIZADO
  CANCELADO
}

enum EstadoFactura {
  POR_EMITIR
  PENDIENTE_AUTORIZACION
  EMITIDA
  POR_CONFIRMAR
}

enum EstadoPago {
  POR_COBRAR
  PROGRAMADO
  SUJETO_A_FIRMA
  SIN_PROGRAMAR
  PARCIAL
  PAGADO
}

enum Modalidad {
  EFECTIVO
  ESPECIE
  ACCIONES
}

enum TipoCompromiso {
  ENTREGABLE
  SEGUIMIENTO
  FECHA_CLAVE
}

enum EstadoCompromiso {
  PENDIENTE
  EN_CURSO
  REQUIERE_ATENCION
  CUMPLIDO
  CANCELADO
}

model Usuario {
  id           String    @id @default(cuid())
  usuario      String    @unique
  nombre       String
  correo       String?
  passwordHash String
  rol          Rol
  directorId   String?
  director     Director? @relation(fields: [directorId], references: [id])
  activo       Boolean   @default(true)
  debeCambiarClave Boolean @default(false) // obliga a cambiar la contraseña al ingresar
  creadoEn     DateTime  @default(now())
  ultimoAcceso DateTime?
  icsToken     String?   // liga privada del calendario personal
  bitacora     Bitacora[]
  compromisosAsignados Compromiso[] @relation("Asignacion")
  compromisosCreados   Compromiso[] @relation("Creacion")
  documentos   Documento[]
  avisos       Aviso[]
  incidenciasReportadas Incidencia[] @relation("IncidenciasReportadas")
  incidenciasAsignadas  Incidencia[] @relation("IncidenciasAsignadas")
  comentarios  ComentarioIncidencia[]

  @@index([icsToken])
}

model Director {
  id        String   @id @default(cuid())
  nombre    String
  correo    String?
  activo    Boolean  @default(true)
  esDemo    Boolean  @default(false)
  notas     String?
  creadoEn  DateTime @default(now())
  usuarios  Usuario[]
  carteras  Cartera[]
  contratos Contrato[]
  reglas    ReglaComision[]
  pagosComision PagoComision[]
}

model Marca {
  id        String   @id @default(cuid())
  nombre    String   @unique
  sector    String?
  notas     String?
  esDemo    Boolean  @default(false)
  creadoEn  DateTime @default(now())
  carteras  Cartera[]
  contactos Contacto[]
  contratos Contrato[]
  reglas    ReglaComision[]
  incidencias Incidencia[]
}

// Asignación Marca ↔ Director con vigencia. Una marca puede cambiar de manos.
model Cartera {
  id         String    @id @default(cuid())
  marcaId    String
  marca      Marca     @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  directorId String
  director   Director  @relation(fields: [directorId], references: [id])
  desde      DateTime  @default(now())
  hasta      DateTime?
  notas      String?

  @@index([directorId, hasta])
  @@index([marcaId, hasta])
}

model Contacto {
  id                String    @id @default(cuid())
  marcaId           String
  marca             Marca     @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  nombre            String
  cargo             String?
  correo            String?
  telefono          String?
  canalPreferido    String?
  ultimaInteraccion DateTime?
  notas             String?
  creadoEn          DateTime  @default(now())
}

model Contrato {
  id              String         @id @default(cuid())
  codigo          String         @unique
  marcaId         String
  marca           Marca          @relation(fields: [marcaId], references: [id])
  directorId      String
  director        Director       @relation(fields: [directorId], references: [id])
  proyecto        String
  tipo            TipoContrato
  estado          EstadoContrato
  monto           Int?           // sin IVA; null cuando aún no hay propuesta
  montoConfirmado Boolean        @default(false)
  inicio          DateTime?
  inicioConfirmado Boolean       @default(false)
  vencimiento     DateTime?
  vencimientoConfirmado Boolean  @default(false)
  duracionMeses   Int?
  talento         String?
  brief           String?        // acuerdos de contenido, visible para producción; sin montos
  propuestaIa     Json?          // lectura automática del contrato en PDF, pendiente de aprobación
  propuestaIaEn   DateTime?
  documentoUrl    String?
  renovacionDeId  String?        @unique
  renovacionDe    Contrato?      @relation("Renovacion", fields: [renovacionDeId], references: [id])
  renovacion      Contrato?      @relation("Renovacion")
  notas           String?
  observaciones   String?        // contradicciones o datos por conciliar detectados en la importación
  creadoEn        DateTime       @default(now())
  actualizadoEn   DateTime       @updatedAt
  hitos           HitoCobro[]
  compromisos     Compromiso[]
  documentos      Documento[]
  incidencias     Incidencia[]

  @@index([directorId, estado])
  @@index([marcaId])
  @@index([vencimiento])
}

// Acción acordada con la marca (entregable) o seguimiento interno con fecha.
model Compromiso {
  id          String           @id @default(cuid())
  contratoId  String
  contrato    Contrato         @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tipo        TipoCompromiso   @default(ENTREGABLE)
  descripcion String
  fecha       DateTime?
  responsable String?
  asignadoAId String?
  asignadoA   Usuario?         @relation("Asignacion", fields: [asignadoAId], references: [id])
  creadoPorId String?
  creadoPor   Usuario?         @relation("Creacion", fields: [creadoPorId], references: [id])
  estado      EstadoCompromiso @default(PENDIENTE)
  reporte     String?          // lo que informa quien ejecuta la tarea
  cumplidoEn  DateTime?
  notas       String?
  creadoEn    DateTime         @default(now())
  actualizadoEn DateTime       @updatedAt

  @@index([contratoId])
  @@index([fecha])
  @@index([asignadoAId, estado])
}

// Hito de cobro: cada factura o pago previsto de un contrato.
enum CategoriaDocumento {
  CONTRATO
  FACTURA_PDF
  FACTURA_XML
  COMPROBANTE
  OTRO
}

model HitoCobro {
  id              String        @id @default(cuid())
  contratoId      String
  contrato        Contrato      @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  // Flujo: programado → solicitado (con factura) → autorizado por dirección → pagado (con comprobante)
  solicitadoEn    DateTime?
  solicitadoPorId String?
  autorizadoEn    DateTime?
  autorizadoPorId String?
  pagoRegistradoPorId String?
  documentos      Documento[]
  concepto        String
  importe         Int
  modalidad       Modalidad     @default(EFECTIVO)
  fechaFacturar   DateTime?
  fechaOrientativa String?      // texto libre cuando no hay fecha exacta ("Febrero 2027")
  estadoFactura   EstadoFactura @default(POR_EMITIR)
  folioFactura    String?
  estadoPago      EstadoPago    @default(POR_COBRAR)
  montoRecibido   Int           @default(0)
  fechaPago       DateTime?
  confirmado      Boolean       @default(false)
  notas           String?
  creadoEn        DateTime      @default(now())
  actualizadoEn   DateTime      @updatedAt

  @@index([contratoId])
  @@index([fechaFacturar])
  @@index([estadoPago])
}

// Regla de comisión fijada por el administrador general.
// Se aplica la regla más específica vigente en la fecha del cobro:
// director+marca+tipo > director+marca > director+tipo > director.
model ReglaComision {
  id            String        @id @default(cuid())
  directorId    String
  director      Director      @relation(fields: [directorId], references: [id])
  marcaId       String?
  marca         Marca?        @relation(fields: [marcaId], references: [id])
  tipo          TipoContrato?
  pctCasa       Decimal       @db.Decimal(6, 4) // retención de Estudio Sports antes de comisión
  pctDirector   Decimal       @db.Decimal(6, 4) // comisión del director sobre el remanente
  vigenteDesde  DateTime
  vigenteHasta  DateTime?
  notas         String?
  creadoEn      DateTime      @default(now())

  @@index([directorId, vigenteDesde])
}

// Comisión efectivamente pagada al director. La devengada se calcula; esta se registra.
model PagoComision {
  id          String    @id @default(cuid())
  directorId  String
  director    Director  @relation(fields: [directorId], references: [id])
  contratoId  String?
  concepto    String
  monto       Int
  modalidad   Modalidad @default(EFECTIVO)
  fechaPago   DateTime?
  confirmado  Boolean   @default(false)
  notas       String?
  creadoEn    DateTime  @default(now())

  @@index([directorId])
  @@index([contratoId])
}

model Bitacora {
  id        String   @id @default(cuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  accion    String   // crear, editar, eliminar, ingresar
  entidad   String
  entidadId String?
  detalle   Json?
  fecha     DateTime @default(now())

  @@index([fecha])
  @@index([entidad, entidadId])
}

// Documento adjunto a un contrato (PDF firmado, anexos). Se guarda en la base
// durante el piloto; con volumen alto se migra a almacenamiento de objetos.
model Documento {
  id          String   @id @default(cuid())
  contratoId  String
  contrato    Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  hitoId      String?
  hito        HitoCobro? @relation(fields: [hitoId], references: [id], onDelete: Cascade)
  categoria   CategoriaDocumento @default(OTRO)
  nombre      String
  tipoMime    String
  tamano      Int
  contenido   Bytes
  descripcion String?
  subidoPorId String?
  subidoPor   Usuario? @relation(fields: [subidoPorId], references: [id])
  creadoEn    DateTime @default(now())

  @@index([contratoId])
  @@index([hitoId])
}

// Aviso dentro del portal: asignaciones, reportes y cambios de estado.
model Aviso {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  texto     String
  href      String?
  leido     Boolean  @default(false)
  creadoEn  DateTime @default(now())

  @@index([usuarioId, leido, creadoEn])
}

enum TipoIncidencia {
  INCIDENCIA
  PENDIENTE
  PROBLEMA
  SOLICITUD
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum EstadoIncidencia {
  ABIERTA
  EN_ATENCION
  RESUELTA
  CERRADA
}

// Incidencias, pendientes y problemas de cualquier nivel, con responsable y seguimiento.
model Incidencia {
  id            String           @id @default(cuid())
  titulo        String
  descripcion   String?
  tipo          TipoIncidencia   @default(PENDIENTE)
  prioridad     Prioridad        @default(MEDIA)
  estado        EstadoIncidencia @default(ABIERTA)
  reportadoPorId String
  reportadoPor  Usuario          @relation("IncidenciasReportadas", fields: [reportadoPorId], references: [id])
  asignadoAId   String?
  asignadoA     Usuario?         @relation("IncidenciasAsignadas", fields: [asignadoAId], references: [id])
  contratoId    String?
  contrato      Contrato?        @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  marcaId       String?
  marca         Marca?           @relation(fields: [marcaId], references: [id], onDelete: SetNull)
  fechaLimite   DateTime?
  resueltoEn    DateTime?
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt
  comentarios   ComentarioIncidencia[]

  @@index([estado, prioridad])
  @@index([asignadoAId, estado])
  @@index([reportadoPorId])
}

model ComentarioIncidencia {
  id           String     @id @default(cuid())
  incidenciaId String
  incidencia   Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)
  usuarioId    String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id])
  texto        String
  creadoEn     DateTime   @default(now())

  @@index([incidenciaId])
}
